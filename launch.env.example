# ---------------------------------------------------------------------------
# MILL launch configuration. Copy to launch.env, fill in, never commit it.
#   cp launch.env.example launch.env && chmod 600 launch.env
# No private keys live here. Signing is always --account deployer.
# ---------------------------------------------------------------------------

RH_RPC=https://rpc.mainnet.chain.robinhood.com
EXPLORER=https://robinhoodchain.blockscout.com
CHAIN_ID=4663

# --- who signs and who owns -------------------------------------------------
DEPLOYER=0x                 # address of the `deployer` keystore account
OWNER=0x                    # Mill owner. A multisig. Can move the split, not the funds.
HOOK_OWNER=0x               # hook owner. Same multisig.
FEE_RECIPIENT=0x            # protocol revenue
RESCUER=0x                  # can return stranded LP NFTs and sweep an empty vault

# --- the tokens -------------------------------------------------------------
MILL_TOKEN=0x               # the MILL governance token (phase 1 output)
QUOTE=0x                    # what mMILL is paired against. NOT MILL itself.
MILL=0x                     # the mMILL vault (phase 2 output)

# --- immutable at deploy. You cannot change these later. --------------------
MILL_NAME=Milled MILL
MILL_SYMBOL=mMILL
WRAP_FEE_BPS=25             # max 100
UNWRAP_FEE_BPS=50           # max 300
MIN_BURN_BPS=5000           # permanent floor on the holders' share
BURN_BPS=7000               # burned to holders
LP_BPS=1000                 # to the staking vault
SEED_AMOUNT=0               # underlying to wrap at deploy, 0 to skip
SEED_RECIPIENT=0x           # required when SEED_AMOUNT > 0

# --- pool -------------------------------------------------------------------
# Market price of ONE WHOLE underlying in WHOLE quote, 1e18-scaled. Required
# whenever QUOTE is not the underlying itself — `ratio()` says what a share is
# worth in MILL, not in wETH, and the difference is the price of MILL.
#   MILL at 0.0005 wETH  ->  QUOTE_PER_ASSET=500000000000000
# Leave unset only when QUOTE == the Mill's own asset().
QUOTE_PER_ASSET=
LP_FEE=3000
TICK_SPACING=60
SELL_BPS=100                # directional hook fee on the SELL side. Buy side is 0.
HOOK_VAULT=0x               # where the hook sends swap fees. Must accept both
                            # currencies. NEVER the Mill.

# --- filled in as you go ----------------------------------------------------
HOOK=0x
LENS=0xA2aF7b4cbbaeF5BFe0999D279CFF81544A179a46
LP_STAKING=0x
POOL_BLOCK=                 # block the pool was initialised in

# --- fixed infrastructure ---------------------------------------------------
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
POSM=0x58daec3116aae6D93017bAAea7749052E8a04fA7
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
